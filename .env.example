# Copy this file to .env and fill in your keys.
# ArrAI loads .env automatically on startup.

# Required — used by Sherlock, Garak, and scorer (default models are gpt-4o / gpt-4o-mini)
OPENAI_API_KEY=sk-...

# Optional — only required for Anthropic targets or Anthropic agent models
ANTHROPIC_API_KEY=sk-ant-...

# Optional — Azure OpenAI (set these if using target_type: azure_openai)
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
